+/** openChecks 含 cycle 主腿 + `cycle::leg` 多腿;列表去重只留腿键或无多腿时的 cycle 键 */
+function openCheckItems(map: Record<string, WheelOpenPositionItem>): WheelOpenPositionItem[] {
+  const vals = Object.values(map)
+  const legged = vals.filter(i => Object.keys(map).some(k => k.startsWith(`${i.cycle_id}::`) && map[k] === i))
+  if (legged.length) {
+    const seen = new Set<string>()
+    const out: WheelOpenPositionItem[] = []
+    for (const [k, i] of Object.entries(map)) {
+      if (!k.includes('::')) continue
+      const id = `${i.cycle_id}|${(i as any).cc_leg_key || i.contract_code || i.strike}`
+      if (seen.has(id)) continue
+      seen.add(id)
+      out.push(i)
+    }
+    return out
+  }
+  return vals
 }
 
