# TradeForge backend local configuration example
# Copy to backend/.env and fill with your local values. Do not commit backend/.env.

FINNHUB_API_KEY=your_finnhub_api_key_here
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# Notion Integration secret (private draft board sync). Never commit real token.
# Prefer settings page backend_config.notion.token; env is fallback.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (defaults match smile's draft board):
# NOTION_PAGE_ID=3d271fa5-7f68-8182-8f5a-d86eff5ca643
# NOTION_DB_POSITIONS=c99ca82a-77c2-4514-b032-0c9869a5cae8
# NOTION_DB_TOUCHES=a3704582-5dcb-4efc-83b7-11a1bd7b0bc9
# NOTION_DB_SIM=5539f0fe-bc10-4d91-89c3-7ef07814b8ea
